# Binaries
/bin/
*.exe
*.dll
*.so
*.dylib
# Root-level built binaries only — anchored so they don't swallow the
# cmd/keyway and cmd/keyway-runner *source* directories (which they did).
/keyway
/keyway-runner
/keyway-cloud

# Test & coverage
*.test
*.out
coverage.html
/testdata/tmp/

# Go workspace
go.work
go.work.sum

# Env & secrets
.env
.env.local
*.pem
*.key
!testdata/**/*.pem

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store

# Web
web/node_modules/
web/dist/
web/.vite/
*.log
npm-debug.log*

# Docker / local data
/.data/
/pgdata/

# Benchmark artifacts
/bench/out/
scorecard.json
roc.svg

# stray root build artifact from `go build ./bench/l2`
/l2
/measurement

# Measurement-study pilot outputs (regenerate with `make measure`)
/bench/measurement/out/
