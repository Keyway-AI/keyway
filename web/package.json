{
  "name": "keyway-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Keyway web dashboard",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
