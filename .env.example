# Copy to .env and adjust. Loaded by the CLI/runner and docker compose.

# --- Storage ---------------------------------------------------------------
KEYWAY_DB_URL=postgres://keyway:keyway@localhost:5432/keyway?sslmode=disable

# --- API server ------------------------------------------------------------
KEYWAY_API_ADDR=:8080
# Bearer token required by all API endpoints. Generate a strong random value.
KEYWAY_API_TOKEN=change-me

# --- Safety ----------------------------------------------------------------
# Comma-separated allowlist of hosts the probe engine may target. Default deny.
KEYWAY_PROBE_ALLOWLIST=staging.internal,svc.cluster.local

# --- Issuer credentials (referenced by name from config, never inline) -----
# keyway issuer add --admin-credential-env KC_ADMIN
KC_ADMIN=admin:admin

# --- Notifications (optional) ----------------------------------------------
KEYWAY_SLACK_WEBHOOK_URL=
